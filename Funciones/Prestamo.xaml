<Window x:Class="proyecto_00.Funciones.Prestamo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:proyecto_00.Funciones"
        mc:Ignorable="d"
        Title="Historial" Height="450" Width="800">
    <Grid Margin="24px">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24px"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Libros}"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="10*"/>
                <DataGridTextColumn Header="Genero" Binding="{Binding Genero}" Width="10*"/>
                <DataGridTextColumn Header="Edicion" Binding="{Binding Edicion}" Width="10*"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="10*"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="10*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="4" 
                Content="Prestamo" 
                Width="100" 
                Height="30" 
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Click="CerrarButton_Click"/>
        <Button
            Grid.Row="2" 
                Content="Volver" 
                Width="100" 
                Height="30" 
                HorizontalAlignment="Right"
                Margin="0,10,128,0"
                Click="VolverButton"/>
    </Grid>

</Window>