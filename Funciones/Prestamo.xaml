<Window x:Class="proyecto_00.Funciones.Prestamo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:proyecto_00.Funciones"
        mc:Ignorable="d"
        Title="Historial" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="Seleccione un libro para solicitar préstamo" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Lista de libros -->
        <DataGrid Grid.Row="1" x:Name="LibrosDataGrid" 
                  ItemsSource="{Binding Libros}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="LibrosDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Título" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Autor" Binding="{Binding genero}" Width="*"/>
                <DataGridTextColumn Header="Año" Binding="{Binding Edicion}" Width="100"/>
                <DataGridTextColumn Header="Disponibles" Binding="{Binding Estado}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Solicitar Préstamo" x:Name="SolicitarButton" 
                    Click="SolicitarButton_Click" 
                    Padding="10,5" Margin="0,0,10,0" IsEnabled="False"/>
            <Button Content="Volver" Click="VolverButton" Padding="10,5" Margin="0,0,10,0"/>
            <Button Content="Cerrar" Click="CerrarButton_Click" Padding="10,5"/>
        </StackPanel>
    </Grid>

</Window>