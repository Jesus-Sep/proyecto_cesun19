<Window x:Class="proyecto_00.Funciones.AgregarLibros"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:proyecto_00.Funciones"
        mc:Ignorable="d"
        Title="AgregarLibros" Height="450" Width="800">
    <Grid Margin="15">
        <StackPanel>
            <TextBlock Text="Agregar Nuevo Libro" 
                      FontSize="18" 
                      FontWeight="Bold" 
                      HorizontalAlignment="Center" 
                      Margin="0,0,0,20"/>

            <!-- Campos del formulario -->
            <Label Content="Título:"/>
            <TextBox x:Name="txtTitulo" Height="30" Margin="0,0,0,10"/>

            <Label Content="Autor:"/>
            <TextBox x:Name="txtAutor" Height="30" Margin="0,0,0,10"/>

            <Label Content="Año de publicación:"/>
            <TextBox x:Name="txtAnio" Height="30" Margin="0,0,0,10"/>

            <Label Content="Cantidad disponible:"/>
            <TextBox x:Name="txtCantidad" Height="30" Margin="0,0,0,20"/>

            <!-- Botones -->
            <Button Content="Agregar Libro" 
                    Click="AgregarButton_Click" 
                    Height="35" 
                    Background="#FF4CAF50" 
                    Foreground="White"/>

            <Button Content="Cancelar" 
                    Click="CancelarButton_Click" 
                    Height="35" 
                    Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
