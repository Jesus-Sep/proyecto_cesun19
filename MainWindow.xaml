<Window x:Class="proyecto_00.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:proyecto_00"
        xmlns:Vistas="clr-namespace:proyecto_00.Vistas"
        mc:Ignorable="d"
        Title="Proyecto" Height="450" Width="800">
    <Window.Resources>
        <DataTemplate x:Name="CrearCuenta" DataType="{x:Type Vistas:CrearCuenta}">
            <Vistas:CrearCuenta DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate x:Name="Inicio_sesion" DataType="{x:Type Vistas:Inicio_Sesion}">
            <Vistas:Inicio_Sesion DataContext="{Binding}"/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Menu Height="48" Width="Auto" Padding="8">
            <MenuItem Header="Iniciar Secion" Padding="0 8" Margin="4 0" Height="48" Click="HandleInicio_Sesion"/>
            <MenuItem Header="Crear cuenta" Padding="0 8" Margin="4 0" Height="48" Click="HandleCrearCuenta"/>
            <MenuItem Header="Salir" Padding="0 8" Margin="4 0" Height="48" Click="Salir"/>
        </Menu>
        <ScrollViewer Grid.Row="1">
            <ContentControl Content="{Binding}"/>
        </ScrollViewer>
    </Grid>
</Window>
