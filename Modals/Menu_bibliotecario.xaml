<Window x:Class="proyecto_00.Modals.Menu_bibliotecario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:proyecto_00.Modals"
        mc:Ignorable="d"
        Title="Menu_bibliotecario" Height="450" Width="800">
    <Grid>
        <!-- Grid con una sola columna y filas para cada botón -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Botón 1 -->
                <RowDefinition Height="10"/>
                <!-- Espacio -->
                <RowDefinition Height="Auto"/>
                <!-- Botón 2 -->
                <RowDefinition Height="10"/>
                <!-- Espacio -->
                <RowDefinition Height="Auto"/>
                <!-- Botón 3 -->
                <RowDefinition Height="10"/>
                <!-- Espacio -->
                <RowDefinition Height="Auto"/>
                <!-- Botón 4 -->
            </Grid.RowDefinitions>

            <!-- Botones --> 
            <Button Grid.Row="0" Content="Aceptar prestamo" FontSize="16" Height="48" Width="200" x:Name="btm1" Click="AceptarPrestamo"/>
            <Button Grid.Row="2" Content="Imprimir" FontSize="16" Height="48" Width="200" x:Name="btnImprimir" Click="Imprimir" />
            <Button Grid.Row="4" Content="Agregar Libros" FontSize="16" Height="48" Width="200" x:Name="AgregarLibro" Click="AgregarLibros"/>
            <Button Grid.Row="6" Content="Salir" FontSize="16" Height="48" Width="200" x:Name="btn4" Click="Salir"/>
        </Grid>
    </Grid>
</Window>
