<Window x:Class="proyecto_00.Modals.Menu_Usuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:proyecto_00.Modals"
        mc:Ignorable="d"
        Title="Menu_Usuario" Height="450" Width="800">
    <Grid>
        <!-- Grid con una sola columna y filas para cada botón -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Botón 1 -->
                <RowDefinition Height="10"/>
                <!-- Espacio -->
                <RowDefinition Height="Auto"/>
                <!-- Botón 2 -->
                <RowDefinition Height="10"/>
                <!-- Espacio -->
                <RowDefinition Height="Auto"/>
                <!-- Botón 3 -->
                <RowDefinition Height="10"/>
                <!-- Espacio -->
                <RowDefinition Height="Auto"/>
                <!-- Botón 4 -->
            </Grid.RowDefinitions>

            <!-- Botones -->
            <Button Grid.Row="0" Content="Solicitar prestamo" FontSize="16" Height="48" Width="200" x:Name="btn1" Click="btn1_Click" />
            <Button Grid.Row="2" Content="Historial de prestamos" FontSize="16" Height="48" Width="200" x:Name="btn2" Click="Historial"/>
            <Button Grid.Row="4" Content="Imprimir prestamo" FontSize="16" Height="48" Width="200" x:Name="btn3"/>
            <Button Grid.Row="6" Content="Salir" FontSize="16" Height="48" Width="200" x:Name="btn4" Click="Salir"/>
        </Grid>
    </Grid>
</Window>
