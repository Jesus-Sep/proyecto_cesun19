<UserControl x:Class="proyecto_00.Vistas.CrearCuenta"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:proyecto_00.Vistas"
             mc:Ignorable="d"
             Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Sistema de Préstamos de Libros" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <TextBlock Text="Crear nueva cuenta" 
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Campos del formulario -->
            <Label Content="Nombre completo:"/>
            <TextBox x:Name="txtNombre" 
                     Height="30" 
                     Margin="0,0,0,10"/>

            <Label Content="Correo electrónico:"/>
            <TextBox x:Name="txtEmail" 
                     Height="30" 
                     Margin="0,0,0,10"/>

            <Label Content="Contraseña:"/>
            <PasswordBox x:Name="txtPassword" 
                         Height="30" 
                         Margin="0,0,0,20"/>

            <!-- Botón de registro -->
            <Button x:Name="btnRegistrar" 
                    Content="Registrarse" 
                    Height="35" 
                    Background="#FF4CAF50" 
                    Foreground="White" 
                    FontWeight="Bold"
                    Click="BtnRegistrar_Click"/>

            <TextBlock HorizontalAlignment="Center" Margin="0,15,0,0">
                <Hyperlink NavigateUri="LoginWindow.xaml" 
                           RequestNavigate="Hyperlink_RequestNavigate">
                    ¿Ya tienes cuenta? Inicia sesión
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
